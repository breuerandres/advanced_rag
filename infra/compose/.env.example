COMPOSE_PROJECT_NAME=advanced-rag
PUBLIC_DOMAIN=localhost
LETSENCRYPT_EMAIL=admin@example.com

CUSTOMER_TIMEZONE=UTC

POSTGRES_DB=advanced_rag
POSTGRES_SUPERUSER=postgres
POSTGRES_APP_USER=app_owner
POSTGRES_RAG_USER=rag_owner
POSTGRES_REPORTING_USER=app_reporting_reader

OPENAI_CHAT_MODEL=gpt-4.1-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024

S3_BUCKET=advanced-rag-document-images
S3_REGION=us-east-1

RAG_SEMANTIC_CACHE_TTL_HOURS=24
RAG_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.90

# Query-time multimodal RAG: attach a capped set of authorized document images
# (from the final retrieved chunks) to the answer model. Multimodal answers are
# never written to the semantic cache.
MULTIMODAL_ENABLED=true
MULTIMODAL_MAX_IMAGES=3
MULTIMODAL_MAX_TOTAL_IMAGE_BYTES=5242880
MULTIMODAL_IMAGE_DETAIL=low
DOTNET_INTERNAL_BASE_URL=http://dotnet-api:8080

AI_DEFAULT_MONTHLY_BUDGET_USD=5.00
TECH_LOG_RETENTION_DAYS=30
POSTGRES_BACKUP_RETENTION_DAYS=14

CHAT_MAX_QUESTION_CHARS=4000
CHAT_FEEDBACK_COMMENT_MAX_CHARS=1000
REVIEW_COMMENT_MAX_CHARS=2000
